<div class="flex flex-col gap-6 w-full">
  <form class="pl-3 ">
    <textarea
      type="text"
      name="contenu"
      placeholder="what's happening ?"
      class=" w-full focus:outline-none pt-5 pl-3"
    ></textarea>
  </form>
  <div class="px-2 flex items-center justify-between pb-1">
    <ul class="flex items-center gap-3">
      <li class="cursor-pointer">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-image text-[#1D9BF0]"
        >
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
          <circle cx="9" cy="9" r="2" />
          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
        </svg>
      </li>
      <li class="cursor-pointer">
        <img src="/resources/imgs/Gif.svg" alt="gif" />
      </li>
      <li class="cursor-pointer">
        <img src="/resources/imgs/Poll.svg" alt="poll" />
      </li>
      <li class="cursor-pointer">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-smile text-[#1D9BF0]"
        >
          <circle cx="12" cy="12" r="10" />
          <path d="M8 14s1.5 2 4 2 4-2 4-2" />
          <line x1="9" x2="9.01" y1="9" y2="9" />
          <line x1="15" x2="15.01" y1="9" y2="9" />
        </svg>
      </li>
      <li class="cursor-pointer">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-calendar-clock text-[#1D9BF0]"
        >
          <path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5" />
          <path d="M16 2v4" />
          <path d="M8 2v4" />
          <path d="M3 10h5" />
          <path d="M17.5 17.5 16 16.3V14" />
          <circle cx="16" cy="16" r="6" />
        </svg>
      </li>
    </ul>
    <button class="px-4 py-2 bg-[#1D9BF0] text-white rounded-2xl">Tweet</button>
  </div>
</div>
