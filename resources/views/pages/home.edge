<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>
      Twiter clone UI
    </title>

    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      href="https://fonts.bunny.net/css?family=instrument-sans:400,400i,500,500i,600,600i,700,700i"
      rel="stylesheet"
    />

    <style>
      :root {
        --sand-1: #fdfdfc;
        --sand-2: #f9f9f8;
        --sand-3: #f1f0ef;
        --sand-4: #e9e8e6;
        --sand-5: #e2e1de;
        --sand-6: #dad9d6;
        --sand-7: #cfceca;
        --sand-8: #bcbbb5;
        --sand-9: #8d8d86;
        --sand-10: #82827c;
        --sand-11: #63635e;
        --sand-12: #21201c;
      }
    </style>

    <script src="https://cdn.tailwindcss.com">
      
    </script>

    <script>
      tailwind.config = {
        theme: {
          extend: {
            fontFamily: {
              sans: [ "Instrument Sans", "sans-serif" ]
            },
            colors: {
              primary: {
                DEFAULT: "#000000",
                lighter: "#a599ff"
              },
              sand: {
                1: "var(--sand-1)",
                2: "var(--sand-2)",
                3: "var(--sand-3)",
                4: "var(--sand-4)",
                5: "var(--sand-5)",
                6: "var(--sand-6)",
                7: "var(--sand-7)",
                8: "var(--sand-8)",
                9: "var(--sand-9)",
                10: "var(--sand-10)",
                11: "var(--sand-11)",
                12: "var(--sand-12)"
              }
            }
          }
        }
      };
    </script>

    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="min-h-screen w-screen font-sans bg-black text-[#D9D9D9] flex justify-center px-3">
    {{-- <div class="flex items-center justify-center"> --}}

    <div class="w-[275px]  flex  flex-col  gap-3  min-h-full ">
      <div class="flex flex-col px-3 gap-2 py-4">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="lucide lucide-twitter"
        >
          <path
            d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"
          />
        </svg>
        <ul class="flex flex-col justify-start gap-2 ">
          <li class="flex  items-center gap-4">
            <img src="/resources/imgs/Home-Fill.png" />
            Home
          </li>
          <li class="flex items-center gap-4">
            <img src="/resources/imgs/Explore.png" />
            Explore
          </li>
          <li class="flex items-center gap-4">
            <img src="/resources/imgs/Notifications.png" />
            Notifications
          </li>
          <li class="flex items-center gap-4">
            <img src="/resources/imgs/Messages.svg" />
            Messages
          </li>
          <li class="flex items-center gap-4">
            <img src="/resources/imgs/Bookmarks.svg" />
            Bookmarks
          </li>
          <li class="flex items-center gap-4">
            <img src="/resources/imgs/Lists.svg" />
            Lists
          </li>
          <li class="flex items-center gap-4">
            <img src="/resources/imgs/Profile.svg" />
            Profile
          </li>
          <li class="flex items-center gap-4">
            <img src="/resources/imgs/More.svg" />
            More
          </li>
        </ul>

      </div>
      <div class="pl-3">
        <button class="bg-blue-500 rounded-4xl px-16 py-2 text-white">Tweet</button>
      </div>

    </div>
    <div class="flex-none border border-[#2F3336] pt-2  max-lg:flex-1 md:w-1/2 max-lg:px-0 ">
      <div class="flex justify-between items-center border-b  border-[#2F3336] w-full">
        <h1 class="px-4 py-4  font-bold text-xl text-white  ">
          Home
        </h1>
        <img src="/resources/imgs/Top-Tweets.svg" />
      </div>
      <div class="flex gap-2 pl-4 pt-1 border-b border-[#2F3336]">
        <div>
          <img src="/resources/imgs/Profile-Photo.svg" alt="profil user" class="flex justify-start" />
        </div>
        <div class="flex flex-col gap-6 w-full">
          <form class="pl-3 ">
            <textarea
              type="text"
              name="contenu"
              placeholder="what's happening ?"
              class=" w-full focus:outline-none pt-5 pl-3"
            ></textarea>
          </form>
          <div class="px-2 flex items-center justify-between pb-1">
            <ul class="flex items-center gap-3">
              <li class="cursor-pointer">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-image text-[#1D9BF0]"
                >
                  <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
                  <circle cx="9" cy="9" r="2" />
                  <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
                </svg>
              </li>
              <li class="cursor-pointer">
                <img src="/resources/imgs/Gif.svg" alt="gif" />
              </li>
              <li class="cursor-pointer">
                <img src="/resources/imgs/Poll.svg" alt="poll" />
              </li>
              <li class="cursor-pointer">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-smile text-[#1D9BF0]"
                >
                  <circle cx="12" cy="12" r="10" />
                  <path d="M8 14s1.5 2 4 2 4-2 4-2" />
                  <line x1="9" x2="9.01" y1="9" y2="9" />
                  <line x1="15" x2="15.01" y1="9" y2="9" />
                </svg>
              </li>
              <li class="cursor-pointer">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="lucide lucide-calendar-clock text-[#1D9BF0]"
                >
                  <path d="M21 7.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h3.5" />
                  <path d="M16 2v4" />
                  <path d="M8 2v4" />
                  <path d="M3 10h5" />
                  <path d="M17.5 17.5 16 16.3V14" />
                  <circle cx="16" cy="16" r="6" />
                </svg>
              </li>
            </ul>
            <button class="px-4 py-2 bg-[#1D9BF0] text-white rounded-2xl">Tweet</button>
          </div>
        </div>
      </div>
      <div class="flex  px-4 py-4 ">
        <div>
          <img src="/resources/imgs/Tweet-Profile-Photo.svg" alt="profil user" class="flex justify-start" />
        </div>
        <div class="flex flex-col gap-3 w-full pl-3">
          <div class="flex flex-col gap-1">
            <span class="font-bold text-sm flex gap-1">CNN <img src="/resources/imgs/Verified.svg" class="w-5 h-5" /></span>
            <p class="text-sm">
              President Joe Biden touted a new agreement reached with the European Union to ease
             Trump-era tariffs on aluminum and steel as a "major breakthrough" that would serve 
             to both strengthen the US steel industry and combat the global climate crisis.
            </p>
          </div>
          <div class="px-2 flex items-center justify-between pb-1">
            <div class="flex gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-message-circle text-[#6E767D]"
              >
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
              </svg>              <span class="text-[#6E767D] text-sm">30</span>
            </div>
            <div class="flex gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-repeat-2 text-[#6E767D]"
              >
                <path d="m2 9 3-3 3 3" />
                <path d="M13 18H7a2 2 0 0 1-2-2V6" />
                <path d="m22 15-3 3-3-3" />
                <path d="M11 6h6a2 2 0 0 1 2 2v10" />
              </svg>              <span class="text-[#6E767D] text-sm">30</span>
            </div>
            <div class="flex gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-heart text-[#6E767D]"
              >
                <path
                  d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
                />
              </svg>              <span class="text-[#6E767D] text-sm">30</span>
            </div>
            <div class="flex gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-arrow-up-from-line"
              >
                <path d="m18 9-6-6-6 6" />
                <path d="M12 3v14" />
                <path d="M5 21h14" />
              </svg>              <span class="text-[#6E767D] text-sm">30</span>
            </div>
          </div>
        </div>

      </div>
      <div class="flex  px-4 py-4 ">
        <div>
          <img src="/resources/imgs/blog.svg" alt="profil user" class="flex justify-start" />
        </div>
        <div class="flex flex-col gap-3 w-full pl-3">
          <div class="flex flex-col gap-1">
            <span class="font-bold text-sm flex gap-1">The New York Times <img src="/resources/imgs/Verified.svg" class="w-5 h-5" /></span>
            <p class="text-sm">
              President Joe Biden touted a new agreement reached with the European Union to ease
             Trump-era tariffs on aluminum and steel as a "major breakthrough" that would serve 
             to both strengthen the US steel industry and combat the global climate crisis.
            </p>
          </div>
          <div class="px-2 flex items-center justify-between pb-1">
            <div class="flex gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-message-circle text-[#6E767D]"
              >
                <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z" />
              </svg>              <span class="text-[#6E767D] text-sm">30</span>
            </div>
            <div class="flex gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-repeat-2 text-[#6E767D]"
              >
                <path d="m2 9 3-3 3 3" />
                <path d="M13 18H7a2 2 0 0 1-2-2V6" />
                <path d="m22 15-3 3-3-3" />
                <path d="M11 6h6a2 2 0 0 1 2 2v10" />
              </svg>              <span class="text-[#6E767D] text-sm">30</span>
            </div>
            <div class="flex gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-heart text-[#6E767D]"
              >
                <path
                  d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
                />
              </svg>              <span class="text-[#6E767D] text-sm">30</span>
            </div>
            <div class="flex gap-2">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="lucide lucide-arrow-up-from-line"
              >
                <path d="m18 9-6-6-6 6" />
                <path d="M12 3v14" />
                <path d="M5 21h14" />
              </svg>              <span class="text-[#6E767D] text-sm">30</span>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="w-[360px] max-lg:hidden flex flex-col gap-3 pt-4 ml-[30px] rounded-2xl text-sm ">

      <div class="flex ">
        <div
          class="bg-[#202327] w-10 h-10  shadow rounded-l-4xl flex items-center justify-center cursor-pointer"
        >
          <img src="/resources/imgs/Search.svg" alt="search" class="" />        </div>
        <input
          type="text"
          name="search"
          placeholder="search twitter"
          class="bg-[#202327]  shadow rounded-r-4xl w-[310px] h-10 focus:outline-none"
        />
      </div>
      <div class="bg-[#202327] px-3 py-3 rounded-2xl">
        <div class=" flex justify-between px-3 pb-3">
          <span class=" ">Trends for you</span>          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-settings"
          >
            <path
              d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
            />
            <circle cx="12" cy="12" r="3" />
          </svg>
        </div>

        <div class="flex flex-col gap-1 px-3 ">
          <span class="text-sm text-[#6E767D]">Trending in Turkey</span>
          <span>#SQUID</span>

          <span class="text-sm text-[#6E767D]">2,066 Tweets</span>

        </div>
        <div class="flex flex-col gap-1 px-3 ">
          <span class="text-sm text-[#6E767D]">Trending in Turkey</span>
          <span>#SQUID</span>

          <span class="text-sm text-[#6E767D]">2,066 Tweets</span>

        </div>
        <div class="flex flex-col gap-1 px-3 ">
          <span class="text-sm text-[#6E767D]">Trending in Turkey</span>
          <span>#SQUID</span>

          <span class="text-sm text-[#6E767D]">2,066 Tweets</span>

        </div>
        <div class="flex flex-col gap-1 px-3 ">
          <span class="text-sm text-[#6E767D]">Trending in Turkey</span>
          <span>#SQUID</span>

          <span class="text-sm text-[#6E767D]">2,066 Tweets</span>

        </div>
      </div>

    </div>
    {{-- </div> --}}
  </body>
</html>
